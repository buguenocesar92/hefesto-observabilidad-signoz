# =============================================================================
# SigNoz — variables de entorno para Hefesto
# COPIA ESTE ARCHIVO A `.env` Y EDITA `.env`. NUNCA COMMITEES `.env`.
#
#   cp .env.example .env
#   chmod 600 .env
#
# ─────────────────────────────────────────────────────────────────────────────
# CÓMO GENERAR LOS SECRETOS
# ─────────────────────────────────────────────────────────────────────────────
#
#   # Contraseña del metastore PostgreSQL (alfanumérica, sin caracteres
#   # especiales: viaja dentro de una URL DSN).
#   openssl rand -base64 24 | tr -d '/+=' | cut -c1-32
#
#   # Contraseña del usuario administrador raíz de SigNoz.
#   # Usa un gestor de passwords; esta es solo una alternativa:
#   openssl rand -base64 32
#
# ─────────────────────────────────────────────────────────────────────────────
# ESTE ARCHIVO NO CONTIENE NINGÚN SECRETO REAL. TODOS LOS VALORES SON
# EJEMPLOS FALSOS O PLACEHOLDERS.
# ─────────────────────────────────────────────────────────────────────────────


# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL — metastore (cuentas, organizaciones, tableros, reglas de alerta)
# ─────────────────────────────────────────────────────────────────────────────

# OBLIGATORIA. Contraseña del usuario `signoz` de PostgreSQL.
# Debe ser alfanumérica y SIN caracteres especiales: se interpola dentro de
# SIGNOZ_SQLSTORE_POSTGRES_DSN como texto de una URL.
# El compose falla a propósito si falta (`:?`), en vez de levantar con
# una contraseña vacía.
POSTGRES_PASSWORD=cambiame-por-una-cadena-aleatoria


# ─────────────────────────────────────────────────────────────────────────────
# Usuario administrador raíz de SigNoz
# Disponible desde SigNoz v0.112.0.
# Fuente: https://signoz.io/docs/manage/administrator-guide/configuration/root-user/
# ─────────────────────────────────────────────────────────────────────────────
#
# ⚠️  USO TEMPORAL. Estas variables crean el administrador en el ARRANQUE, antes
#     de que exista la primera sesión web. Eso cierra el hueco en que un
#     atacante podría registrar el primer usuario.
#     Cuando confirmes que puedes entrar, VACÍA ESTAS VARIABLES y reinicia.
#     Si las dejas puestas, la contraseña queda en el `.env` de producción.
#
#   SIGNOZ_USER_ROOT_ENABLED=true
#   SIGNOZ_USER_ROOT_EMAIL=admin@tucliente.cl
#   SIGNOZ_USER_ROOT_PASSWORD=<contraseña-fuerte>
#   SIGNOZ_USER_ROOT_ORG_NAME=default

# Ponlas en `true` SOLO durante el despliegue inicial.
SIGNOZ_USER_ROOT_ENABLED=false
SIGNOZ_USER_ROOT_EMAIL=
SIGNOZ_USER_ROOT_PASSWORD=
# Nombre de la organización. Si más adelante agregas clientes a esta misma
# instancia, el nombre queda visible en la UI. Usa el nombre real del cliente.
SIGNOZ_USER_ROOT_ORG_NAME=default


# ─────────────────────────────────────────────────────────────────────────────
# Exposición de puertos
# ─────────────────────────────────────────────────────────────────────────────

# Interfaz donde se publica la UI en el puerto 8080.
#   127.0.0.1  → solo el servidor. Lo normal cuando hay un proxy inverso
#                 (Traefik de Coolify, nginx, Caddy) delante.
#   0.0.0.0    → cualquiera que llegue al servidor ve la UI. Solo con HTTPS
#                 y firewall bien puesto.
# Cámbialo a 0.0.0.0 si accedes directo por IP sin proxy.
SIGNOZ_BIND_ADDRESS=127.0.0.1